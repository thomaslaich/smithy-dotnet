---
/**
 * LandingPage — full custom landing, ported from the Claude Design
 * "Smithy Landing.dc.html" (violet / Space Grotesk design).
 *
 * Rendered inside Starlight's splash page; Starlight's own chrome (header,
 * content max-width) is hidden/neutralised on the landing page only — see the
 * `html.nsmithy-landing` rules below. The marker class is added in <head> via
 * index.mdx frontmatter so there is no flash.
 */
import LandingTree from './LandingTree.astro';

// Base-relative so it works on the local dev server and the deployed site
// (the GitHub Pages base is /smithy-dotnet). `repo` stays absolute — it's external.
const intro = '/smithy-dotnet/getting-started/introduction/';
const quickstart = '/smithy-dotnet/getting-started/quick-start/';
const repo = 'https://github.com/thomaslaich/smithy-dotnet';

---

<script is:inline>
  // Scroll reveal: add `reveal-ready` synchronously (before content paints) so
  // .reveal elements start hidden without a flash, then reveal as they enter view.
  (function () {
    if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    document.documentElement.classList.add('reveal-ready');
    function init() {
      var els = document.querySelectorAll('.reveal');
      if (!('IntersectionObserver' in window)) {
        els.forEach(function (el) { el.classList.add('is-visible'); });
        return;
      }
      var io = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (e) {
            if (e.isIntersecting) {
              e.target.classList.add('is-visible');
              io.unobserve(e.target);
            }
          });
        },
        { threshold: 0.1, rootMargin: '0px 0px -8% 0px' }
      );
      els.forEach(function (el) { io.observe(el); });
    }
    if (document.readyState !== 'loading') init();
    else document.addEventListener('DOMContentLoaded', init);
  })();
</script>

<div class="nsl not-content">
  <LandingTree />

  <!-- Header -->
  <header class="nsl-header">
    <div class="nsl-header-inner">
      <a class="nsl-brand" href="/smithy-dotnet/">
        <span>NSmithy</span>
      </a>
      <div class="nsl-header-actions">
        <button type="button" class="nsl-theme" aria-label="Toggle theme"></button>
        <a class="nsl-btn nsl-btn-primary nsl-btn-sm" href={quickstart}>Get Started</a>
      </div>
    </div>
  </header>

  <!-- Hero -->
  <section class="nsl-hero">
    <div class="nsl-hero-inner">
      <div class="nsl-hero-copy">
        <h1 class="nsl-h1 reveal">Smithy for&nbsp;.NET</h1>
        <p class="nsl-lead reveal" style="--reveal-delay: 60ms">
          Generate C# clients and servers from <a href="https://smithy.io">Smithy</a> models.
          Integrated with MSBuild.
        </p>
        <div class="nsl-hero-actions reveal" style="--reveal-delay: 120ms">
          <a class="nsl-btn nsl-btn-primary" href={quickstart}>Get Started</a>
          <a class="nsl-btn nsl-btn-ghost" href={repo}>View on GitHub</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="nsl-footer">
    <div class="nsl-footer-inner">
      <a class="nsl-brand" href="/smithy-dotnet/">
        <span>NSmithy</span>
      </a>
      <div class="nsl-footer-links">
        <a href={intro}>Docs</a>
        <a href={repo}>GitHub</a>
        <a href="https://smithy.io">Smithy.io</a>
      </div>
      <span class="nsl-footer-copy">© 2026 · MIT licensed</span>
    </div>
  </footer>
</div>

<style is:global>
  /* ── Theme tokens (landing only) ─────────────────────────────────────────── */
  html.nsmithy-landing {
    --bg: #08080c;
    --bg2: #0d0d14;
    --panel: #101019;
    --text: #f5f5f8;
    --dim: #a2a2b2;
    --faint: #6a6a7c;
    --border: #20202c;
    --borderSoft: #171720;
    --accent: #6d4aff;
    --accentText: #b8a5ff;
    --pill: #13131c;
  }
  html.nsmithy-landing[data-theme='light'] {
    --bg: #f6f6f8;
    --bg2: #ffffff;
    --panel: #ffffff;
    --text: #0e0e14;
    --dim: #54546a;
    --faint: #8a8a9a;
    --border: #e6e6ec;
    --borderSoft: #eeeef2;
    --accentText: #5b35e0;
    --pill: #f1f1f5;
  }

  /* ── Scroll reveal (deliberately subtle: short rise, gentle fade) ────────── */
  .reveal {
    transition:
      opacity 0.5s ease-out,
      transform 0.5s ease-out;
    transition-delay: var(--reveal-delay, 0s);
  }
  html.reveal-ready .reveal {
    opacity: 0;
    transform: translateY(10px);
  }
  html.reveal-ready .reveal.is-visible {
    opacity: 1;
    transform: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .reveal {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
  }

  /* ── Neutralise Starlight chrome on the landing page only ────────────────── */
  html.nsmithy-landing body {
    background: var(--bg);
    color: var(--text);
    font-family: 'IBM Plex Sans', system-ui, sans-serif;
  }
  html.nsmithy-landing .header,
  html.nsmithy-landing .sidebar-pane,
  html.nsmithy-landing .right-sidebar-container,
  html.nsmithy-landing h1[id='_top'],
  html.nsmithy-landing h1[data-page-title] {
    display: none !important;
  }
  html.nsmithy-landing .main-frame {
    padding-top: 0 !important;
    padding-inline-start: 0 !important;
  }
  html.nsmithy-landing .main-pane,
  html.nsmithy-landing main {
    width: 100% !important;
  }
  html.nsmithy-landing main {
    padding-bottom: 0;
  }
  html.nsmithy-landing main footer:not(.nsl-footer) {
    display: none;
  }
  html.nsmithy-landing .content-panel {
    padding: 0 !important;
    border: 0 !important;
  }
  html.nsmithy-landing .sl-container {
    max-width: none !important;
    margin: 0 !important;
    padding: 0 !important;
  }
  html.nsmithy-landing ::selection {
    background: rgba(109, 74, 255, 0.3);
  }

  html.nsmithy-landing .sl-markdown-content > .nsl {
    margin: 0;
  }

  /* ── Landing root ────────────────────────────────────────────────────────── */
  .nsl {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--bg);
    color: var(--text);
    min-height: 100svh;
  }
  .nsl a {
    text-decoration: none;
  }
  .nsl code {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 0.9em;
  }

  /* ── Header ──────────────────────────────────────────────────────────────── */
  .nsl-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: transparent;
    transition: background-color 180ms ease;
  }
  .nsl-header.is-scrolled {
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }
  @media (prefers-reduced-motion: reduce) {
    .nsl-header { transition: none; }
  }
  .nsl-header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 1180px;
    margin: 0 auto;
    padding: 18px 40px;
  }
  .nsl-brand {
    display: flex;
    align-items: center;
  }
  .nsl-brand span {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 600;
    font-size: 19px;
    letter-spacing: -0.01em;
    color: var(--text);
  }
  .nsl-header-actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .nsl-theme {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    background: var(--pill);
    border: 1px solid var(--border);
    color: var(--dim);
    border-radius: 9px;
    cursor: pointer;
    font-size: 14px;
    transition: color 0.15s ease, border-color 0.15s ease;
  }
  .nsl-theme:hover {
    color: var(--text);
    border-color: var(--accent);
  }

  /* ── Buttons ─────────────────────────────────────────────────────────────── */
  .nsl-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 11px;
    font-weight: 600;
    font-size: 16px;
    padding: 14px 26px;
    transition: background 0.16s ease, border-color 0.16s ease;
  }
  .nsl-btn-sm {
    padding: 10px 18px;
    font-size: 14.5px;
    border-radius: 9px;
  }
  .nsl-btn-primary {
    background: var(--accent);
    color: #fff;
    box-shadow: 0 8px 22px -12px rgba(109, 74, 255, 0.55);
  }
  .nsl-btn-primary:hover {
    background: color-mix(in oklab, var(--accent) 88%, #fff);
  }
  .nsl-btn-ghost {
    background: var(--panel);
    color: var(--text);
    border: 1px solid var(--border);
  }
  .nsl-btn-ghost:hover {
    border-color: var(--accent);
  }

  /* ── Hero ──────────────────────────────────────────────────────────────── */
  .nsl-hero {
    position: relative;
    flex: 1;
    display: flex;
    align-items: center;
    width: 100%;
    padding: 64px 40px 128px;
    box-sizing: border-box;
    max-width: 1180px;
    margin: 0 auto;
    overflow: hidden;
  }
  .nsl-hero-inner {
    position: relative;
    z-index: 1;
    max-width: 1100px;
    margin: 0 auto;
    text-align: center;
  }
  .nsl-hero-copy {
    max-width: 560px;
    width: 100%;
    margin-inline: auto;
    min-width: 0;
  }
  .nsl .nsl-hero-copy {
    position: relative;
    isolation: isolate;
  }
  .nsl .nsl-hero-copy::before {
    content: '';
    position: absolute;
    inset: -80px auto;
    left: 50%;
    width: calc(100% + 200px);
    max-width: calc(100vw - 44px);
    transform: translateX(-50%);
    z-index: -1;
    pointer-events: none;
    background: radial-gradient(
      ellipse at center,
      color-mix(in srgb, var(--bg) 65%, transparent) 0%,
      color-mix(in srgb, var(--bg) 45%, transparent) 40%,
      transparent 72%
    );
  }
  .nsl-h1 {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 600;
    font-size: clamp(38px, 5.4vw, 60px);
    line-height: 1.04;
    letter-spacing: -0.035em;
    color: var(--text);
    margin: 0 0 22px;
  }
  .nsl-lead {
    font-size: clamp(16px, 1.1vw, 19px);
    line-height: 1.55;
    color: var(--dim);
    max-width: 560px;
    margin: 0 0 34px;
    text-wrap: pretty;
  }
  .nsl-hero-actions {
    display: flex;
    gap: 14px;
    justify-content: center;
    margin-bottom: 0;
    flex-wrap: wrap;
  }
  .nsl-lead a {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: var(--faint);
    text-underline-offset: 3px;
  }
  .nsl-lead a:hover {
    color: var(--text);
  }

  /* Footer */
  .nsl-footer {
    margin-top: auto;
    position: relative;
    z-index: 1;
    position: relative;
    z-index: 1;
    border-top: 1px solid var(--borderSoft);
    padding: 30px 40px;
  }
  .nsl-footer-inner {
    max-width: 1180px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    flex-wrap: wrap;
  }
  .nsl-footer-links {
    display: flex;
    gap: 26px;
    font-size: 14px;
  }
  .nsl-footer-links a {
    color: var(--dim);
  }
  .nsl-footer-links a:hover {
    color: var(--text);
  }
  .nsl-footer-copy {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12.5px;
    color: var(--faint);
  }

  /* ── Responsive ──────────────────────────────────────────────────────────── */
  @media (max-width: 48rem) {
    .nsl-header-inner,
    .nsl-footer {
      padding-inline: 22px;
    }
    .nsl-hero {
      padding: 48px 22px 80px;
    }
    .nsl-hero-copy {
      width: 100%;
      max-width: 560px;
      margin-inline: auto;
      text-align: center;
    }
    .nsl-hero-actions {
      justify-content: center;
    }
    .nsl-footer-inner {
      justify-content: center;
      text-align: center;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('.nsl-header');
  if (header) {
    const updateHeader = () => header.classList.toggle('is-scrolled', window.scrollY > 16);
    updateHeader();
    window.addEventListener('scroll', updateHeader, { passive: true });
    window.addEventListener('pageshow', updateHeader);
    document.addEventListener('astro:before-swap', () => {
      window.removeEventListener('scroll', updateHeader);
      window.removeEventListener('pageshow', updateHeader);
    }, { once: true });
  }

  // Theme toggle — drives Starlight's theme (data-theme + localStorage) so the
  // landing and the docs pages stay in sync.
  (function () {
    const btn = document.querySelector<HTMLButtonElement>('.nsl-theme');
    if (!btn) return;
    const sun = '☀︎';
    const moon = '☾︎';
    const current = () =>
      document.documentElement.getAttribute('data-theme') === 'light' ? 'light' : 'dark';
    const paint = () => {
      btn.textContent = current() === 'dark' ? moon : sun;
    };
    paint();
    btn.addEventListener('click', () => {
      const next = current() === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', next);
      try {
        localStorage.setItem('starlight-theme', next);
      } catch {}
      paint();
    });
  })();
</script>
