<script>
  // Theme toggle — drives Starlight's theme (data-theme + localStorage) so the
  // landing and the docs pages stay in sync.
  (function () {
    const btn = document.querySelector<HTMLButtonElement>('.nsl-theme');
    if (!btn) return;
    const sun = '☀︎';
    const moon = '☾︎';
    const current = () =>
      document.documentElement.getAttribute('data-theme') === 'light' ? 'light' : 'dark';
    const paint = () => {
      btn.textContent = current() === 'dark' ? moon : sun;
    };
    paint();
    btn.addEventListener('click', () => {
      const next = current() === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', next);
      try {
        localStorage.setItem('starlight-theme', next);
      } catch {}
      paint();
    });
  })();
</script>
