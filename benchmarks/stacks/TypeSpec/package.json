{
  "name": "bench-stack-typespec",
  "private": true,
  "description": "TypeSpec stack for the NSmithy benchmark suite. Generated from the Smithy-emitted OpenAPI document so the wire contract matches by construction.",
  "scripts": {
    "import": "tsp-openapi3 ../../contract/openapi/BenchmarkService.openapi.json --output-dir ./tsp",
    "generate": "tsp compile ./tsp/main.tsp --emit @typespec/http-server-csharp --option @typespec/http-server-csharp.emitter-output-dir={project-root}/emitted"
  },
  "devDependencies": {
    "@typespec/compiler": "1.17.0",
    "@typespec/http": "1.17.0",
    "@typespec/http-server-csharp": "0.58.0-alpha.33",
    "@typespec/json-schema": "1.17.0",
    "@typespec/openapi3": "1.17.0",
    "@typespec/rest": "0.87.0",
    "@typespec/versioning": "0.87.0"
  },
  "overrides": {
    "@alloy-js/core": "0.25.0",
    "@alloy-js/csharp": "0.25.0",
    "@alloy-js/msbuild": "0.25.0",
    "@alloy-js/typescript": "0.25.0"
  }
}
