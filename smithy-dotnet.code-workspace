{
  "folders": [
    {
      "name": "NSmithy",
      "path": "."
    },
    {
      "name": "Codegen (Java)",
      "path": "codegen"
    },
    {
      "name": "Examples",
      "path": "examples"
    },
    {
      "name": "Benchmarks",
      "path": "benchmarks"
    },
    {
      "name": "Example: Kafka",
      "path": "examples/kafka"
    }
  ],
  "settings": {
    "dotnet.defaultSolution": "NSmithy.slnx",
    "files.exclude": {
      "codegen": true,
      "examples": true,
      "benchmarks": true,
    },
    "files.watcherExclude": {
      "**/.devenv/**": true,
      "**/.direnv/**": true,
      "**/.gradle/**": true,
      "**/artifacts/**": true,
      "**/bin/**": true,
      "**/obj/**": true,
      "**/target/**": true
    },
    "search.exclude": {
      "**/.devenv": true,
      "**/.direnv": true,
      "**/.gradle": true,
      "**/artifacts": true,
      "**/bin": true,
      "**/obj": true,
      "**/target": true
    },
  },
  "extensions": {
    "recommendations": [
      "ms-dotnettools.csdevkit",
      "ms-dotnettools.csharp",
      "vscjava.vscode-java-pack",
      "scalameta.metals",
      "jnoortheen.nix-ide",
      "mkhl.direnv"
    ]
  }
}
