<Project>
  <PropertyGroup>
    <!-- Default location of smithy model files. Override in your .csproj if needed. -->
    <SmithySources Condition="'$(SmithySources)' == ''">$(MSBuildProjectDirectory)/model</SmithySources>
    <!--
      Version of NSmithy's plugin artifacts (smithy-csharp-codegen, smithy-proto-codegen)
      added to the effective smithy-build.json. Override if you need to pin to a specific
      version.
      Example: <SmithyCSharpCodegenVersion>1.0.0</SmithyCSharpCodegenVersion>
    -->
    <!--
      Smithy version NSmithy is built against. Code generation checks the Smithy CLI's
      version against it (see SmithyCliVersionCheck), and software.amazon.smithy:* Maven
      artifacts in your contracts smithy-build.json should use it too.
    -->
    <SmithyVersion Condition="'$(SmithyVersion)' == ''">1.73.0</SmithyVersion>
    <SmithyCSharpCodegenVersion Condition="'$(SmithyCSharpCodegenVersion)' == ''">0.0.0-SNAPSHOT</SmithyCSharpCodegenVersion>
    <!--
      Set to 'true' to add the smithy-docgen plugin to the effective smithy-build.json; the
      generated HTML docs are copied to wwwroot/docs/. Requires SmithyService.
      Example: <SmithyGenerateDocs>true</SmithyGenerateDocs>
    -->
    <SmithyGenerateDocs Condition="'$(SmithyGenerateDocs)' == ''">false</SmithyGenerateDocs>
    <!--
      Set to an HTTP protocol shape ID to add the smithy-openapi plugin to the effective
      smithy-build.json; the generated openapi.json is copied to wwwroot/. Requires
      SmithyService.
      Leave empty (the default) to skip OpenAPI generation.
      Example: <SmithyOpenApiProtocol>aws.protocols#restJson1</SmithyOpenApiProtocol>
    -->
    <SmithyOpenApiProtocol Condition="'$(SmithyOpenApiProtocol)' == ''"></SmithyOpenApiProtocol>
  </PropertyGroup>
</Project>
