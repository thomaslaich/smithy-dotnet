<Project>
  <PropertyGroup>
    <!-- Default location of smithy model files. Override in your .csproj if needed. -->
    <SmithySources Condition="'$(SmithySources)' == ''">$(MSBuildProjectDirectory)/model</SmithySources>
    <!--
      Version of the smithy-csharp-codegen Maven artifact injected into the synthesized
      smithy-build.json for server/client projects. Override if you need to pin to a
      specific version.
      Example: <SmithyCSharpCodegenVersion>1.0.0</SmithyCSharpCodegenVersion>
    -->
    <!--
      Smithy CLI version bundled in this package. software.amazon.smithy:* Maven
      artifacts in your contracts smithy-build.json should use this version.
    -->
    <SmithyVersion Condition="'$(SmithyVersion)' == ''">1.71.0</SmithyVersion>
    <SmithyCSharpCodegenVersion Condition="'$(SmithyCSharpCodegenVersion)' == ''">0.6.0-SNAPSHOT</SmithyCSharpCodegenVersion>
    <!--
      Set to 'true' to inject the smithy-docgen plugin into the synthesized smithy-build.json
      and copy the generated HTML docs to wwwroot/docs/.
      Example: <SmithyGenerateDocs>true</SmithyGenerateDocs>
    -->
    <SmithyGenerateDocs Condition="'$(SmithyGenerateDocs)' == ''">false</SmithyGenerateDocs>
    <!--
      Set to an HTTP protocol shape ID to inject the smithy-openapi plugin into the
      synthesized smithy-build.json and copy the generated openapi.json to wwwroot/.
      Leave empty (the default) to skip OpenAPI generation.
      Example: <SmithyOpenApiProtocol>aws.protocols#restJson1</SmithyOpenApiProtocol>
    -->
    <SmithyOpenApiProtocol Condition="'$(SmithyOpenApiProtocol)' == ''"></SmithyOpenApiProtocol>
  </PropertyGroup>
</Project>
