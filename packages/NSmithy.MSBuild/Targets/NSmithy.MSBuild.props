<Project>
  <PropertyGroup>
    <!-- Default location of smithy model files. Override in your .csproj if needed. -->
    <SmithySources Condition="'$(SmithySources)' == ''">$(MSBuildProjectDirectory)/model</SmithySources>
    <!--
      Version of the smithy-csharp-codegen Maven artifact injected into the synthesized
      smithy-build.json for server/client projects. Override if you need to pin to a
      specific version.
      Example: <SmithyCSharpCodegenVersion>1.0.0</SmithyCSharpCodegenVersion>
    -->
    <!--
      Smithy CLI version bundled in this package. software.amazon.smithy:* Maven
      artifacts in your contracts smithy-build.json should use this version.
    -->
    <SmithyVersion Condition="'$(SmithyVersion)' == ''">1.68.0</SmithyVersion>
    <SmithyCSharpCodegenVersion Condition="'$(SmithyCSharpCodegenVersion)' == ''">0.1.0-SNAPSHOT</SmithyCSharpCodegenVersion>
  </PropertyGroup>
</Project>
