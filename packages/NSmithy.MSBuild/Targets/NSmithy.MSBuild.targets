<Project>
  <!--
    NSmithy.MSBuild.targets — imported in every project that has NSmithy.MSBuild in its
    NuGet dependency tree (directly or via NSmithy.Server / NSmithy.Client).

    Two independent behaviours, both opt-in via properties:

      SmithyPublish=true   Publish the model that smithy-build.json names: to the
                           projects that reference this one (GetSmithyShapeReferences),
                           in the NuGet package, and (when SmithyMavenGroupId is also
                           set) as a Maven JAR: the build runs the contracts-jar Smithy
                           plugin, and pack copies its JAR and POM next to the .nupkg.
                           Requires the smithy-build.json, which also lets IDE tooling
                           (Smithy VS Code / IntelliJ extensions) resolve traits from
                           Maven dependencies.

      (code generation)    Runs automatically when a smithy-build.json exists at the
                           project root, or when SmithySource items are present
                           (collected from a contracts ProjectReference). The CLI runs an
                           effective smithy-build.json written to obj/: the project's own
                           file (or an empty one), the contracts' inputs, and the plugin
                           settings from SmithyService and the other generation
                           properties. See designs/build-configuration.md.
  -->

  <!-- ================================================================
       Property defaults.
       The package has no build/ props: NuGet imports this file into every project
       with NSmithy.MSBuild in its dependency tree, including those that get it
       through NSmithy.Client, so every default lives here. It is imported after the
       project file, so a value the project sets always wins.
       ================================================================ -->
  <PropertyGroup>
    <!-- The Smithy version NSmithy is built against. Code generation checks the Smithy CLI's
         version against it (see SmithyCliVersionCheck). -->
    <SmithyVersion Condition="'$(SmithyVersion)' == ''">1.74.1</SmithyVersion>
    <!-- The version of NSmithy's plugin artifacts in the effective smithy-build.json. -->
    <SmithyCSharpCodegenVersion Condition="'$(SmithyCSharpCodegenVersion)' == ''"
      >0.0.0-SNAPSHOT</SmithyCSharpCodegenVersion>
    <!-- Adds the smithy-docgen plugin; its HTML is copied to wwwroot/docs/. Needs SmithyService. -->
    <SmithyGenerateDocs Condition="'$(SmithyGenerateDocs)' == ''">false</SmithyGenerateDocs>
    <!-- An HTTP protocol shape id adds the smithy-openapi plugin; its openapi.json is copied to
         wwwroot/. Needs SmithyService. -->
    <SmithyOpenApiProtocol Condition="'$(SmithyOpenApiProtocol)' == ''"></SmithyOpenApiProtocol>
  </PropertyGroup>

  <!-- ================================================================
       MSBuild tasks
       $(MSBuildThisFileDirectory) → buildTransitive/ in the NuGet cache;
       the DLL lives in tasks/net10.0/ one level up.
       ================================================================ -->

  <PropertyGroup>
    <_NSmithyTasksAssembly>$(MSBuildThisFileDirectory)..\tasks\net10.0\NSmithy.MSBuild.dll</_NSmithyTasksAssembly>
    <!-- In-repo consumers import Targets/ directly and reference NSmithy.MSBuild as a project,
         so the tasks come from its build output. They run out of process so a reused MSBuild
         node does not keep that freshly built DLL loaded. -->
    <_NSmithyTasksFromProject Condition="!Exists('$(_NSmithyTasksAssembly)')"
      >true</_NSmithyTasksFromProject>
    <_NSmithyTasksAssembly Condition="'$(_NSmithyTasksFromProject)' == 'true'"
      >$(MSBuildThisFileDirectory)..\bin\$(Configuration)\net10.0\NSmithy.MSBuild.dll</_NSmithyTasksAssembly>
    <_NSmithyTaskFactory Condition="'$(_NSmithyTasksFromProject)' == 'true'"
      >TaskHostFactory</_NSmithyTaskFactory>
  </PropertyGroup>

  <UsingTask
    TaskName="WriteSmithyBuildFile"
    AssemblyFile="$(_NSmithyTasksAssembly)"
    TaskFactory="$(_NSmithyTaskFactory)"
  />

  <UsingTask
    TaskName="ReportSmithyCliDiagnostics"
    AssemblyFile="$(_NSmithyTasksAssembly)"
    TaskFactory="$(_NSmithyTaskFactory)"
  />

  <UsingTask
    TaskName="ResolveSmithySources"
    AssemblyFile="$(_NSmithyTasksAssembly)"
    TaskFactory="$(_NSmithyTaskFactory)"
  />

  <!-- ================================================================
       Publishing a model (SmithyPublish=true) to project references and
       packages. Every project has GetSmithyShapeReferences, so that any of them
       can sit between a consumer and the contracts it references.
       ================================================================ -->

  <!--
    The model files a project publishes: those its smithy-build.json names in sources and imports,
    the same files it generates its own shapes from. Directories expand to the .smithy and .json
    files Smithy loads from them.
  -->
  <Target Name="_SmithyResolvePublishedSources" Condition="'$(SmithyPublish)' == 'true'">
    <Error
      Code="NSMITHYPUBLISH"
      Text="NSmithy: SmithyPublish=true needs a smithy-build.json ($(SmithyBuildFile)). Its sources and imports name the model files to publish, and IDE tooling reads it to resolve traits from Maven dependencies."
      Condition="!Exists('$(SmithyBuildFile)')"
    />
    <ResolveSmithySources
      BuildFile="$(SmithyBuildFile)"
      ProjectDirectory="$(MSBuildProjectDirectory)"
    >
      <Output TaskParameter="Sources" ItemName="_SmithyPublishedSource" />
    </ResolveSmithySources>
  </Target>

  <!--
    Returns what a project needs from this one and everything this one references, to build its
    model with theirs and use the shapes they generated instead of generating them again:
    their shape manifests (SmithyKind=Manifest) and, for projects that publish their model,
    its files (Source) and smithy-build.json (BuildFile). Items this project contributes itself
    have SmithyDirect=true; those from its references have SmithyDirect=false. Called by
    _CollectSmithyItemsFromProjectReferences. See designs/shape-ownership.md.
  -->
  <Target
    Name="GetSmithyShapeReferences"
    DependsOnTargets="_SmithyResolvePublishedSources"
    Returns="@(_SmithyShapeReference)"
  >
    <MSBuild
      Projects="@(ProjectReference)"
      Targets="GetSmithyShapeReferences"
      Properties="BuildProjectReferences=false"
      SkipNonexistentTargets="true"
      Condition="'@(ProjectReference)' != ''"
    >
      <Output TaskParameter="TargetOutputs" ItemName="_SmithyReferencedShapeReference" />
    </MSBuild>
    <ItemGroup>
      <_SmithyShapeReferenceCandidate
        Include="$(_SmithyAllManifestsGlob)"
        SmithyKind="Manifest"
        SmithyDirect="true"
      />
      <_SmithyShapeReferenceCandidate
        Include="@(_SmithyPublishedSource)"
        SmithyKind="Source"
        SmithyDirect="true"
      />
      <_SmithyShapeReferenceCandidate
        Include="$(SmithyBuildFile)"
        SmithyKind="BuildFile"
        SmithyDirect="true"
        Condition="'$(SmithyPublish)' == 'true'"
      />
      <_SmithyShapeReferenceCandidate
        Include="@(_SmithyReferencedShapeReference)"
        SmithyDirect="false"
      />
    </ItemGroup>
    <!-- Full paths, so that callers can compare them; the first, and so this project's own, of
         two equal items wins. -->
    <RemoveDuplicates Inputs="@(_SmithyShapeReferenceCandidate->'%(FullPath)')">
      <Output TaskParameter="Filtered" ItemName="_SmithyShapeReference" />
    </RemoveDuplicates>
  </Target>

  <!-- ================================================================
       Pack integration — SmithyPublish=true only
       ================================================================ -->

  <ItemGroup Condition="'$(SmithyPublish)' == 'true'">
    <None
      Include="$(SmithyBuildFile)"
      Pack="true"
      PackagePath="build/smithy-build.json"
      Condition="Exists('$(SmithyBuildFile)')"
    />
  </ItemGroup>

  <PropertyGroup Condition="'$(SmithyPublish)' == 'true'">
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);_SmithyPackContracts</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <!--
    Packs the published model under build/smithy/, the shape manifest of SmithyProjection as
    build/nsmithy-shapes.json, so that consumers refer to the types the package's assembly
    contains instead of generating them again, and buildTransitive/<PackageId>.props, which
    declares both to every project that references the package, so that a PackageReference is
    all a consumer needs. It runs at pack time, after the build wrote the manifest and once
    PackageId is known. A project that generates no shapes (SmithyGenerateCode=false) has no
    manifest, and its consumers generate its shapes.
  -->
  <Target Name="_SmithyPackContracts" DependsOnTargets="_SmithyResolvePublishedSources">
    <Error
      Code="NSMITHYPUBLISH"
      Text="NSmithy: the model source %(_SmithyPublishedSource.Identity) is outside the project directory, so it has no place in the package. Move it into the project, or into a contracts project of its own."
      Condition="'%(_SmithyPublishedSource.Identity)' != '' and '%(_SmithyPublishedSource.PackagePath)' == ''"
    />
    <PropertyGroup>
      <!-- Next to these targets in the repository, under tools/ in the NSmithy.MSBuild package. -->
      <_SmithyContractsPackageProps>$(MSBuildThisFileDirectory)NSmithy.ContractsPackage.props</_SmithyContractsPackageProps>
      <_SmithyContractsPackageProps Condition="!Exists('$(_SmithyContractsPackageProps)')"
        >$(MSBuildThisFileDirectory)../tools/NSmithy.ContractsPackage.props</_SmithyContractsPackageProps>
    </PropertyGroup>
    <ItemGroup>
      <TfmSpecificPackageFile
        Include="@(_SmithyPublishedSource)"
        PackagePath="%(_SmithyPublishedSource.PackagePath)"
      />
      <TfmSpecificPackageFile
        Include="$(_SmithyContractsPackageProps)"
        PackagePath="buildTransitive/$(PackageId).props"
      />
      <TfmSpecificPackageFile
        Include="$(SmithyGeneratedOutputPath)nsmithy-shapes.json"
        PackagePath="build/nsmithy-shapes.json"
        Condition="Exists('$(SmithyGeneratedOutputPath)nsmithy-shapes.json')"
      />
    </ItemGroup>
  </Target>

  <!--
    After dotnet pack, put the Maven JAR, POM, and checksums next to the NuGet package. The build
    produced them: with SmithyMavenGroupId set, the effective smithy-build.json runs the
    contracts-jar plugin. Projects that only want NuGet distribution leave SmithyMavenGroupId unset.
  -->
  <Target
    Name="_CopySmithyContractsJar"
    AfterTargets="Pack"
    Condition="'$(SmithyPublish)' == 'true' and '$(SmithyMavenGroupId)' != ''"
  >
    <PropertyGroup>
      <_SmithyContractsJarDir>$(SmithyBuildOutputPath)$(SmithyProjection)/contracts-jar/</_SmithyContractsJarDir>
    </PropertyGroup>
    <ItemGroup>
      <_SmithyContractsJarFile Include="$(_SmithyContractsJarDir)$(SmithyMavenArtifactId)-$(PackageVersion).jar*;$(_SmithyContractsJarDir)$(SmithyMavenArtifactId)-$(PackageVersion).pom*" />
    </ItemGroup>
    <Error
      Code="NSMITHYMAVEN"
      Text="NSmithy: found no $(SmithyMavenArtifactId)-$(PackageVersion).jar in $(_SmithyContractsJarDir). Build the project before packing it."
      Condition="'@(_SmithyContractsJarFile)' == ''"
    />
    <Copy
      SourceFiles="@(_SmithyContractsJarFile)"
      DestinationFolder="$(PackageOutputAbsolutePath)"
      SkipUnchangedFiles="true"
    />
  </Target>

  <!-- ================================================================
       Code generation — runs when smithy-build.json exists or SmithySource
       items are present (from a contracts ProjectReference)
       ================================================================ -->

  <PropertyGroup>
    <SmithyBuildFile Condition="'$(SmithyBuildFile)' == ''"
      >$(MSBuildProjectDirectory)/smithy-build.json</SmithyBuildFile>
    <SmithyProjection Condition="'$(SmithyProjection)' == ''">source</SmithyProjection>
    <!-- An F# project generates F#: fsharp-codegen writes Types.g.fs and Schemas.g.fs, which
         _AddSmithyGeneratedFSharpCompileItems compiles in that order ahead of the project's own
         files. -->
    <_SmithyIsFSharp Condition="'$(MSBuildProjectExtension)' == '.fsproj'">true</_SmithyIsFSharp>
    <SmithyPlugin Condition="'$(SmithyPlugin)' == '' and '$(_SmithyIsFSharp)' == 'true'"
      >fsharp-codegen</SmithyPlugin>
    <SmithyPlugin Condition="'$(SmithyPlugin)' == ''">csharp-codegen</SmithyPlugin>
    <_SmithyGeneratedExtension Condition="'$(_SmithyIsFSharp)' == 'true'"
      >fs</_SmithyGeneratedExtension>
    <_SmithyGeneratedExtension Condition="'$(_SmithyIsFSharp)' != 'true'"
      >cs</_SmithyGeneratedExtension>
    <SmithyBuildOutputPath Condition="'$(SmithyBuildOutputPath)' == ''"
      >$(IntermediateOutputPath)Smithy/</SmithyBuildOutputPath>
    <SmithyGeneratedOutputPath Condition="'$(SmithyGeneratedOutputPath)' == ''"
      >$(SmithyBuildOutputPath)$(SmithyProjection)/$(SmithyPlugin)/</SmithyGeneratedOutputPath>
    <SmithyAllProjectionsGlob Condition="'$(SmithyAllProjectionsGlob)' == ''"
      >$(SmithyBuildOutputPath)*/$(SmithyPlugin)/**/*.g.$(_SmithyGeneratedExtension)</SmithyAllProjectionsGlob>
    <!-- The shape manifests the code generator writes: generated output like the code, so a run that
         no longer writes one removes it, and consumers never see shapes the assembly does not have. -->
    <_SmithyAllManifestsGlob>$(SmithyBuildOutputPath)*/$(SmithyPlugin)/nsmithy-shapes.json</_SmithyAllManifestsGlob>
    <SmithyProtoPlugin Condition="'$(SmithyProtoPlugin)' == ''">proto-codegen</SmithyProtoPlugin>
    <SmithyAllProtosGlob Condition="'$(SmithyAllProtosGlob)' == ''"
      >$(SmithyBuildOutputPath)*/$(SmithyProtoPlugin)/**/*.proto</SmithyAllProtosGlob>
    <SmithyGrpcServices Condition="'$(SmithyGrpcServices)' == ''">Both</SmithyGrpcServices>
    <SmithyExtraArgs Condition="'$(SmithyExtraArgs)' == ''"></SmithyExtraArgs>
    <SmithyGenerateClient Condition="'$(SmithyGenerateClient)' == ''">true</SmithyGenerateClient>
  </PropertyGroup>

  <!--
    Pre-register the smithy-generated .proto as a <Protobuf> item STATICALLY
    (outside any target body) so that Grpc.Tools' Protobuf_Compile target is
    included in the build graph.

    MSBuild evaluates Protobuf_Compile's Condition="'@(Protobuf)' != ''" at
    graph-build time, before any targets run. Items added inside target bodies
    (like _AddSmithyGeneratedProtoItems) are invisible at that point, so
    Protobuf_Compile would be excluded from the graph and Grpc.Tools would
    never generate C# from the proto file.

    The glob here is identical to what _AddSmithyGeneratedProtoItems adds.
    On the very first build after a clean obj (proto does not exist yet) the
    glob expands to empty, Protobuf_Compile is skipped, and compilation fails.
    Running 'dotnet build' a second time picks up the proto file that the
    first-pass smithy build produced and compilation succeeds.

    This is a known two-pass limitation for gRPC projects with a generated
    proto. Checked-in proto files (e.g. non-smithy setups) do not have this
    restriction.
  -->
  <ItemGroup Condition="'$(SmithyGrpc)' == 'true'">
    <Protobuf
      Include="$(SmithyAllProtosGlob)"
      GrpcServices="$(SmithyGrpcServices)"
      ProtoRoot="$(SmithyBuildOutputPath)"
      Access="Public"
      Visible="$(SmithyEmitGeneratedFiles)"
    />
  </ItemGroup>

  <!-- ================================================================
       Smithy CLI, in order of precedence:

         1. $(SmithyCliPath), set by the user.
         2. The NSmithy.SmithyCli package, when the project references it: its props
            set NSmithySmithyCliDirectory and NSmithySmithyCliVersion, and we pick
            the build host's distribution from it.
         3. smithy on PATH.

       GenerateSmithyCode checks the CLI's version against $(SmithyVersion):
       SmithyCliVersionCheck is exact, minimum (at least that version), or none.
       It defaults to exact for the package, which NSmithy pairs with one Smithy
       version, and to minimum for a CLI the user provides.
       ================================================================ -->

  <!-- Detect OS and CPU architecture -->
  <PropertyGroup>
    <_SmithyIsWindows>$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Windows)))</_SmithyIsWindows>
    <_SmithyIsMacOS>$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::OSX)))</_SmithyIsMacOS>
    <_SmithyArchStr>$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)</_SmithyArchStr>
  </PropertyGroup>

  <!-- Map OS + arch to the Smithy CLI release platform identifier. Smithy ships no Windows
       arm64 build, so Windows always uses x64 (emulated on arm64). -->
  <PropertyGroup Condition="'$(_SmithyIsMacOS)' == 'True' and '$(_SmithyArchStr)' == 'Arm64'">
    <_SmithyCliPlatform>darwin-aarch64</_SmithyCliPlatform>
  </PropertyGroup>
  <PropertyGroup Condition="'$(_SmithyIsMacOS)' == 'True' and '$(_SmithyArchStr)' == 'X64'">
    <_SmithyCliPlatform>darwin-x86_64</_SmithyCliPlatform>
  </PropertyGroup>
  <PropertyGroup Condition="'$(_SmithyIsWindows)' == 'True'">
    <_SmithyCliPlatform>windows-x64</_SmithyCliPlatform>
  </PropertyGroup>
  <PropertyGroup Condition="'$(_SmithyIsMacOS)' != 'True' and '$(_SmithyIsWindows)' != 'True' and '$(_SmithyArchStr)' == 'Arm64'">
    <_SmithyCliPlatform>linux-aarch64</_SmithyCliPlatform>
  </PropertyGroup>
  <PropertyGroup Condition="'$(_SmithyIsMacOS)' != 'True' and '$(_SmithyIsWindows)' != 'True' and '$(_SmithyArchStr)' == 'X64'">
    <_SmithyCliPlatform>linux-x86_64</_SmithyCliPlatform>
  </PropertyGroup>

  <!-- The launcher in the NSmithy.SmithyCli package, if referenced -->
  <PropertyGroup Condition="'$(NSmithySmithyCliDirectory)' != '' and '$(_SmithyCliPlatform)' != ''">
    <_SmithyPackagedCliPath Condition="'$(_SmithyIsWindows)' == 'True'"
      >$(NSmithySmithyCliDirectory)/windows-x64/bin/smithy.bat</_SmithyPackagedCliPath>
    <_SmithyPackagedCliPath Condition="'$(_SmithyIsWindows)' != 'True'"
      >$(NSmithySmithyCliDirectory)/$(_SmithyCliPlatform)/bin/smithy</_SmithyPackagedCliPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(SmithyCliPath)' == '' and '$(_SmithyPackagedCliPath)' != '' and Exists('$(_SmithyPackagedCliPath)')">
    <SmithyCliPath>$(_SmithyPackagedCliPath)</SmithyCliPath>
    <_SmithyCliFromPackage>true</_SmithyCliFromPackage>
  </PropertyGroup>
  <PropertyGroup Condition="'$(SmithyCliPath)' == ''">
    <SmithyCliPath>smithy</SmithyCliPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(SmithyCliVersionCheck)' == ''">
    <SmithyCliVersionCheck Condition="'$(_SmithyCliFromPackage)' == 'true'"
      >exact</SmithyCliVersionCheck>
    <SmithyCliVersionCheck Condition="'$(_SmithyCliFromPackage)' != 'true'"
      >minimum</SmithyCliVersionCheck>
  </PropertyGroup>

  <!-- ================================================================
       Bundled Maven repo (populated by `gradle :bundleMavenRepo`, packed into
       tools/maven-repo/). When present, codegen resolves the plugin + first-party
       trait packages from it via SMITHY_MAVEN_REPOS against an isolated cache —
       Smithy's own offline mechanism. With SMITHY_MAVEN_REPOS set, the CLI no longer
       assumes Maven Central, so other dependencies resolve only from repositories the
       build file lists. Absent, or with SmithyUseBundledMavenRepo=false, resolution
       uses the build file's maven block alone (Maven Central by default) and the
       user's Maven cache.
       ================================================================ -->
  <PropertyGroup>
    <SmithyUseBundledMavenRepo Condition="'$(SmithyUseBundledMavenRepo)' == ''"
      >true</SmithyUseBundledMavenRepo>
    <_SmithyBundledMavenRepo Condition="'$(SmithyUseBundledMavenRepo)' == 'true'"
      >$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../tools/maven-repo'))</_SmithyBundledMavenRepo>
  </PropertyGroup>

  <PropertyGroup>
    <SmithyGenerateServer Condition="'$(SmithyGenerateServer)' == ''">true</SmithyGenerateServer>
    <!-- Whether the project generates the shapes in its own model files, also without
         SmithyService. See designs/shape-ownership.md. -->
    <SmithyGenerateCode Condition="'$(SmithyGenerateCode)' == ''">true</SmithyGenerateCode>
    <SmithyEmitGeneratedFiles Condition="'$(SmithyEmitGeneratedFiles)' == ''"
      >false</SmithyEmitGeneratedFiles>
    <SmithyStampFile Condition="'$(SmithyStampFile)' == ''"
      >$(SmithyBuildOutputPath)NSmithy.Generated.stamp</SmithyStampFile>
  </PropertyGroup>

  <ItemGroup>
    <_SmithyGeneratorInput
      Include="$(MSBuildProjectDirectory)/**/*.smithy"
      Exclude="$(MSBuildProjectDirectory)/obj/**;$(MSBuildProjectDirectory)/bin/**;$(SmithyBuildOutputPath)**"
    />
    <_SmithyGeneratorInput Include="$(SmithyBuildFile)" Condition="Exists('$(SmithyBuildFile)')" />
    <!-- Rebuild when the bundled codegen plugin/traits change (e.g. package upgrade). -->
    <_SmithyGeneratorInput
      Include="$(_SmithyBundledMavenRepo)/**/*.jar"
      Condition="Exists('$(_SmithyBundledMavenRepo)')"
    />
    <Watch Include="$(SmithyBuildFile)" Condition="Exists('$(SmithyBuildFile)')" />
    <Watch Include="@(_SmithyGeneratorInput)" />
  </ItemGroup>

  <!--
    Collect what the project references publish (see GetSmithyShapeReferences). What the projects
    it references directly contribute themselves makes it generate: their model files become
    SmithySource and their build files SmithyContractsBuildFile. Manifests always apply. What
    those projects only pass on from their own references is used only if the project generates
    anyway (see _PrepareSmithyBuildFile).
  -->
  <Target
    Name="_CollectSmithyItemsFromProjectReferences"
    BeforeTargets="_PrepareSmithyBuildFile"
    Condition="'@(ProjectReference)' != ''"
  >
    <MSBuild
      Projects="@(ProjectReference)"
      Targets="GetSmithyShapeReferences"
      Properties="BuildProjectReferences=false"
      SkipNonexistentTargets="true"
    >
      <Output TaskParameter="TargetOutputs" ItemName="_SmithyReferenceFromProjects" />
    </MSBuild>
    <ItemGroup>
      <_SmithyDirectReference
        Include="@(_SmithyReferenceFromProjects)"
        Condition="'%(_SmithyReferenceFromProjects.SmithyDirect)' == 'true'"
      />
      <SmithySource
        Include="@(_SmithyDirectReference)"
        Condition="'%(_SmithyDirectReference.SmithyKind)' == 'Source'"
      />
      <SmithyContractsBuildFile
        Include="@(_SmithyDirectReference)"
        Condition="'%(_SmithyDirectReference.SmithyKind)' == 'BuildFile'"
      />
      <SmithyShapeManifest
        Include="@(_SmithyReferenceFromProjects)"
        Condition="'%(_SmithyReferenceFromProjects.SmithyKind)' == 'Manifest'"
      />
      <_SmithyIndirectReference
        Include="@(_SmithyReferenceFromProjects)"
        Condition="'%(_SmithyReferenceFromProjects.SmithyDirect)' != 'true' and '%(_SmithyReferenceFromProjects.SmithyKind)' != 'Manifest'"
      />
      <_SmithyIndirectReference Remove="@(_SmithyDirectReference)" />
    </ItemGroup>
  </Target>

  <!--
    Write the effective smithy-build.json that GenerateSmithyCode runs: the project's own build
    file (or an empty one), the contracts' inputs, and the plugin settings from properties. See
    designs/build-configuration.md. Projects with neither a build file nor contracts generate
    nothing.
    The checks on SmithySource are in the target body: MSBuild evaluates a target's Condition
    before its DependsOnTargets run, so SmithySource would always appear empty there.
  -->
  <Target
    Name="_PrepareSmithyBuildFile"
    DependsOnTargets="_CollectSmithyItemsFromProjectReferences;_SmithyResolvePublishedSources"
  >
    <PropertyGroup>
      <_SmithyProjectBuildFile Condition="Exists('$(SmithyBuildFile)')"
        >$(SmithyBuildFile)</_SmithyProjectBuildFile>
      <_SmithyEffectiveBuildFile
        Condition="'$(_SmithyProjectBuildFile)' != '' or '@(SmithySource)' != '' or ('$(SmithyService)' != '' and '@(SmithyPackageReference)' != '')"
        >$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'smithy-build.json'))</_SmithyEffectiveBuildFile>
    </PropertyGroup>
    <PropertyGroup Condition="'$(SmithyPublish)' == 'true'">
      <_SmithyContractsGroupId>$(SmithyMavenGroupId)</_SmithyContractsGroupId>
    </PropertyGroup>
    <!-- A project that generates code also gets the models of the contracts its references
         reference, and of the contracts packages it references directly or transitively (their
         props declare SmithyPackageReference items), which the shapes it uses from them can
         target. A project that generates nothing is left alone. Items a project adds by hand
         are not added twice. -->
    <ItemGroup Condition="'$(_SmithyEffectiveBuildFile)' != ''">
      <_SmithyIndirectReference Include="@(SmithyPackageReference->'%(FullPath)')" />
      <_SmithyIndirectSource
        Include="@(_SmithyIndirectReference)"
        Condition="'%(_SmithyIndirectReference.SmithyKind)' == 'Source'"
      />
      <_SmithyIndirectSource Remove="@(SmithySource)" />
      <SmithySource Include="@(_SmithyIndirectSource)" />
      <_SmithyIndirectBuildFile
        Include="@(_SmithyIndirectReference)"
        Condition="'%(_SmithyIndirectReference.SmithyKind)' == 'BuildFile'"
      />
      <_SmithyIndirectBuildFile Remove="@(SmithyContractsBuildFile)" />
      <SmithyContractsBuildFile Include="@(_SmithyIndirectBuildFile)" />
      <SmithyShapeManifest
        Include="@(_SmithyIndirectReference)"
        Condition="'%(_SmithyIndirectReference.SmithyKind)' == 'Manifest'"
      />
    </ItemGroup>
    <Error
      Text="NSmithy: SmithyService must be set when generating from a contracts reference. Add &lt;SmithyService&gt;my.namespace#MyService&lt;/SmithyService&gt; to your project."
      Condition="'@(SmithySource)' != '' and '$(SmithyService)' == '' and '$(_SmithyProjectBuildFile)' == ''"
    />
    <WriteSmithyBuildFile
      ProjectBuildFile="$(_SmithyProjectBuildFile)"
      ContractsBuildFiles="@(SmithyContractsBuildFile)"
      Sources="@(SmithySource)"
      Service="$(SmithyService)"
      GenerateCode="$(SmithyGenerateCode)"
      ShapeManifests="@(SmithyShapeManifest)"
      GenerateClient="$(SmithyGenerateClient)"
      GenerateServer="$(SmithyGenerateServer)"
      GenerateDocs="$(SmithyGenerateDocs)"
      OpenApiProtocol="$(SmithyOpenApiProtocol)"
      Grpc="$(SmithyGrpc)"
      ProtoPlugin="$(SmithyProtoPlugin)"
      Projection="$(SmithyProjection)"
      Plugin="$(SmithyPlugin)"
      ContractsGroupId="$(_SmithyContractsGroupId)"
      ContractsArtifactId="$(SmithyMavenArtifactId)"
      ContractsVersion="$(PackageVersion)"
      CSharpCodegenVersion="$(SmithyCSharpCodegenVersion)"
      SmithyVersion="$(SmithyVersion)"
      OutputFile="$(_SmithyEffectiveBuildFile)"
      Condition="'$(_SmithyEffectiveBuildFile)' != ''"
    >
      <Output TaskParameter="RunsCodeGenerator" PropertyName="_SmithyRunsCodeGenerator" />
    </WriteSmithyBuildFile>
    <!-- A project that no longer generates anything runs no CLI that could remove its old shape
         manifests, which its references and its package would otherwise still offer. -->
    <ItemGroup Condition="'$(_SmithyEffectiveBuildFile)' == ''">
      <_SmithyLeftoverManifest Include="$(_SmithyAllManifestsGlob)" />
    </ItemGroup>
    <Delete Files="@(_SmithyLeftoverManifest)" Condition="'@(_SmithyLeftoverManifest)' != ''" />
    <ItemGroup Condition="'$(_SmithyEffectiveBuildFile)' != ''">
      <FileWrites Include="$(_SmithyEffectiveBuildFile)" />
    </ItemGroup>
  </Target>

  <!--
    Ensure the packaged Smithy CLI launcher is executable on Unix.
    NuGet does not preserve file permissions, so we chmod +x on first use.
    This is a no-op if the bit is already set, so it's safe to run every build.
    A user-supplied SmithyCliPath is left alone: it may live on a read-only path.
  -->
  <Target
    Name="_EnsureSmithyCliExecutable"
    BeforeTargets="_SmithyGenerateCode"
    Condition="'$(_SmithyIsWindows)' != 'True' and '$(_SmithyCliFromPackage)' == 'true'"
  >
    <Exec Command="chmod +x &quot;$(SmithyCliPath)&quot;" />
  </Target>

  <!--
    The CLI resolves the codegen plugin into SMITHY_MAVEN_CACHE and keys it by Maven coordinate.
    In-repo the version is a fixed 0.0.0-SNAPSHOT, so a rebuilt plugin is indistinguishable from
    the cached one and codegen would keep emitting code from the stale jar. Drop the cache whenever
    a bundled jar changes; the stamp keeps this a no-op on an unchanged tree.

    Both paths hang off SmithyBuildOutputPath, next to the generated code they produce. That keeps
    them configuration-independent like the generated output itself — a per-configuration cache
    behind shared output is worse than either, because one configuration regenerates from a stale
    plugin into output the other then trusts.
  -->
  <PropertyGroup>
    <_SmithyMavenCachePath>$(SmithyBuildOutputPath)maven-cache</_SmithyMavenCachePath>
    <_SmithyMavenCacheStamp>$(SmithyBuildOutputPath)NSmithy.MavenCache.stamp</_SmithyMavenCacheStamp>
  </PropertyGroup>

  <!-- The environment the Smithy CLI runs with: the bundled Maven repo and its isolated cache,
       when the repo holds the codegen plugin (in-repo, the directory exists before it is staged).
       Evaluated here rather than in GenerateSmithyCode so that `dotnet nsmithy smithy` can read it
       with -getProperty and run the CLI exactly as the build does. -->
  <PropertyGroup Condition="'$(_SmithyBundledMavenRepo)' != '' and Exists('$(_SmithyBundledMavenRepo)/io/github/thomaslaich/nsmithy/smithy-csharp-codegen')">
    <NSmithySmithyCliEnvironment>SMITHY_MAVEN_REPOS=$([System.Uri]::new('$(_SmithyBundledMavenRepo)').AbsoluteUri);SMITHY_MAVEN_CACHE=$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(_SmithyMavenCachePath)'))</NSmithySmithyCliEnvironment>
  </PropertyGroup>

  <Target
    Name="_SmithyRefreshMavenCache"
    BeforeTargets="_SmithyGenerateCode"
    Condition="Exists('$(_SmithyBundledMavenRepo)')"
    Inputs="@(_SmithyGeneratorInput)"
    Outputs="$(_SmithyMavenCacheStamp)"
  >
    <RemoveDir
      Directories="$(_SmithyMavenCachePath)"
      Condition="Exists('$(_SmithyMavenCachePath)')"
    />
    <MakeDir Directories="$(SmithyBuildOutputPath)" />
    <Touch Files="$(_SmithyMavenCacheStamp)" AlwaysCreate="true" />
  </Target>

  <!--
    The entry point for code generation, run before CoreCompile or on its own with
    -t:GenerateSmithyCode. It has no condition: whether a project generates is only known once
    _PrepareSmithyBuildFile has written the effective build file, and MSBuild checks a target's
    condition before the targets it depends on or that hook into it run. Dependencies run in
    order, so _SmithyGenerateCode's condition is checked after _PrepareSmithyBuildFile.
  -->
  <Target
    Name="GenerateSmithyCode"
    BeforeTargets="CoreCompile"
    DependsOnTargets="_PrepareSmithyBuildFile;_SmithyGenerateCode"
  />

  <Target
    Name="_SmithyGenerateCode"
    Condition="'$(_SmithyEffectiveBuildFile)' != '' and Exists('$(_SmithyEffectiveBuildFile)')"
    Inputs="@(_SmithyGeneratorInput);@(SmithySource);@(SmithyContractsBuildFile);@(SmithyShapeManifest);$(_SmithyEffectiveBuildFile)"
    Outputs="$(SmithyStampFile)"
  >
    <MakeDir Directories="$(SmithyBuildOutputPath)" />
    <PropertyGroup>
      <_SmithyCliBuildOutput>$(SmithyBuildOutputPath.TrimEnd('/').TrimEnd('\'))</_SmithyCliBuildOutput>
      <_SmithyCliCommand>&quot;$(SmithyCliPath)&quot; build --config &quot;$(_SmithyEffectiveBuildFile)&quot; --output &quot;$(_SmithyCliBuildOutput)&quot; $(SmithyExtraArgs)</_SmithyCliCommand>
      <!-- A redirected JVM writes in the platform encoding unless told otherwise. -->
      <_SmithyCliEnv>$(NSmithySmithyCliEnvironment);SMITHY_OPTS=$(SMITHY_OPTS) -Dstdout.encoding=UTF-8 -Dstderr.encoding=UTF-8</_SmithyCliEnv>
    </PropertyGroup>
    <!-- Check the CLI before running it. Here rather than in a target of its own, so that only
         builds that regenerate pay for starting an external CLI just to ask its version. -->
    <Error
      Code="NSMITHYCLIVERSION"
      Condition="'$(SmithyCliVersionCheck)' != 'minimum' and '$(SmithyCliVersionCheck)' != 'exact' and '$(SmithyCliVersionCheck)' != 'none'"
      Text="NSmithy: SmithyCliVersionCheck is '$(SmithyCliVersionCheck)'; use minimum, exact, or none."
    />
    <PropertyGroup>
      <_SmithyCheckCliVersion Condition="'$(SmithyCliVersionCheck)' != 'none'"
        >true</_SmithyCheckCliVersion>
    </PropertyGroup>
    <Exec
      Command="&quot;$(SmithyCliPath)&quot; --version"
      Condition="'$(_SmithyCheckCliVersion)' == 'true' and '$(_SmithyCliFromPackage)' != 'true'"
      ConsoleToMSBuild="true"
      IgnoreExitCode="true"
      IgnoreStandardErrorWarningFormat="true"
      StandardOutputImportance="Low"
      StandardErrorImportance="Low"
      WorkingDirectory="$(MSBuildProjectDirectory)"
    >
      <Output TaskParameter="ExitCode" PropertyName="_SmithyCliVersionExitCode" />
      <Output TaskParameter="ConsoleOutput" PropertyName="_SmithyCliVersionOutput" />
    </Exec>
    <Error
      Code="NSMITHYCLIMISSING"
      Condition="'$(_SmithyCheckCliVersion)' == 'true' and '$(_SmithyCliFromPackage)' != 'true' and '$(_SmithyCliVersionExitCode)' != '0'"
      Text="NSmithy: could not run the Smithy CLI ($(SmithyCliPath)). Reference the NSmithy.SmithyCli package ($(SmithyVersion)), set SmithyCliPath to a Smithy CLI $(SmithyVersion) or later, or put one on PATH."
    />
    <!-- ConsoleOutput joins the lines with ';'; take the line that is a version, past any JVM
         warnings. Versions compare by their major.minor.patch core. -->
    <PropertyGroup Condition="'$(_SmithyCheckCliVersion)' == 'true'">
      <_SmithyCliVersion Condition="'$(_SmithyCliFromPackage)' == 'true'"
        >$(NSmithySmithyCliVersion)</_SmithyCliVersion>
      <_SmithyCliVersion Condition="'$(_SmithyCliFromPackage)' != 'true'"
        >$([System.Text.RegularExpressions.Regex]::Match('$(_SmithyCliVersionOutput)', '(?:^|;)(\d+\.\d+\.\d+[^;\s]*)').Groups[1].Value)</_SmithyCliVersion>
      <_SmithyCliVersionCore>$([System.Text.RegularExpressions.Regex]::Match('$(_SmithyCliVersion)', '^\d+\.\d+\.\d+').Value)</_SmithyCliVersionCore>
      <_SmithyVersionCore>$([System.Text.RegularExpressions.Regex]::Match('$(SmithyVersion)', '^\d+\.\d+\.\d+').Value)</_SmithyVersionCore>
    </PropertyGroup>
    <Error
      Code="NSMITHYCLIVERSION"
      Condition="'$(_SmithyCheckCliVersion)' == 'true' and ('$(_SmithyCliVersionCore)' == '' or '$(_SmithyVersionCore)' == '')"
      Text="NSmithy: could not read the version of the Smithy CLI ($(SmithyCliPath)), or SmithyVersion ($(SmithyVersion)) is not a version. Set SmithyCliVersionCheck to none to skip this check."
    />
    <Error
      Code="NSMITHYCLIVERSION"
      Condition="'$(SmithyCliVersionCheck)' == 'minimum' and '$(_SmithyCliVersionCore)' != '' and '$(_SmithyVersionCore)' != '' and $([MSBuild]::VersionLessThan('$(_SmithyCliVersionCore)', '$(_SmithyVersionCore)'))"
      Text="NSmithy: Smithy CLI $(_SmithyCliVersion) ($(SmithyCliPath)) is older than SmithyVersion ($(SmithyVersion)). Use Smithy CLI $(SmithyVersion) or later, or set SmithyCliVersionCheck to none to skip this check."
    />
    <Error
      Code="NSMITHYCLIVERSION"
      Condition="'$(SmithyCliVersionCheck)' == 'exact' and '$(_SmithyCliVersionCore)' != '' and '$(_SmithyVersionCore)' != '' and !$([MSBuild]::VersionEquals('$(_SmithyCliVersionCore)', '$(_SmithyVersionCore)'))"
      Text="NSmithy: Smithy CLI $(_SmithyCliVersion) ($(SmithyCliPath)) does not match SmithyVersion ($(SmithyVersion)), and SmithyCliVersionCheck is exact. Use Smithy CLI $(SmithyVersion) (for the package, reference NSmithy.SmithyCli $(SmithyVersion)), or set SmithyCliVersionCheck to minimum or none."
    />

    <!-- What the previous run produced, and when this one starts: see the stale-output cleanup
         after the CLI. -->
    <ItemGroup>
      <_SmithyPreviousOutput Include="$(SmithyAllProjectionsGlob);$(SmithyAllProtosGlob);$(_SmithyAllManifestsGlob)" />
    </ItemGroup>
    <PropertyGroup>
      <_SmithyGenerationStart>$([System.DateTime]::Now.Ticks)</_SmithyGenerationStart>
    </PropertyGroup>
    <Exec
      Command="$(_SmithyCliCommand)"
      EnvironmentVariables="$(_SmithyCliEnv)"
      IgnoreExitCode="true"
      ConsoleToMSBuild="true"
      StdOutEncoding="utf-8"
      StdErrEncoding="utf-8"
      StandardOutputImportance="High"
      StandardErrorImportance="High"
      WorkingDirectory="$(MSBuildProjectDirectory)"
    >
      <Output TaskParameter="ExitCode" PropertyName="_SmithyCliExitCode" />
      <Output TaskParameter="ConsoleOutput" ItemName="_SmithyCliOutput" />
    </Exec>

    <!-- The terminal logger hides the CLI's output, so re-report a failure as MSBuild errors.
         `smithy build` has no machine-readable output, so validate the same model again as
         CSV to get the events with their locations. The tasks assembly targets
         .NET, so .NET Framework MSBuild (Visual Studio) gets the plain error instead. -->
    <PropertyGroup Condition="'$(_SmithyCliExitCode)' != '0'">
      <_SmithyValidationEventsFile>$([System.IO.Path]::GetFullPath('$(SmithyBuildOutputPath)validation-events.csv'))</_SmithyValidationEventsFile>
    </PropertyGroup>
    <Delete
      Files="$(_SmithyValidationEventsFile)"
      Condition="'$(_SmithyCliExitCode)' != '0' and '$(MSBuildRuntimeType)' == 'Core'"
    />
    <Exec
      Command="&quot;$(SmithyCliPath)&quot; validate --format csv --config &quot;$(_SmithyEffectiveBuildFile)&quot; --output &quot;$(_SmithyCliBuildOutput)&quot; $(SmithyExtraArgs) &gt; &quot;$(_SmithyValidationEventsFile)&quot;"
      EnvironmentVariables="$(_SmithyCliEnv)"
      IgnoreExitCode="true"
      IgnoreStandardErrorWarningFormat="true"
      StandardOutputImportance="Low"
      StandardErrorImportance="Low"
      WorkingDirectory="$(MSBuildProjectDirectory)"
      Condition="'$(_SmithyCliExitCode)' != '0' and '$(MSBuildRuntimeType)' == 'Core'"
    />
    <ReportSmithyCliDiagnostics
      ValidationEventsFile="$(_SmithyValidationEventsFile)"
      BuildOutput="@(_SmithyCliOutput)"
      ExitCode="$(_SmithyCliExitCode)"
      Command="$(_SmithyCliCommand)"
      WorkingDirectory="$(MSBuildProjectDirectory)"
      Condition="'$(_SmithyCliExitCode)' != '0' and '$(MSBuildRuntimeType)' == 'Core'"
    />
    <Error
      Code="NSMITHYCLI"
      Text="NSmithy: Smithy CLI failed with exit code $(_SmithyCliExitCode). See the build output for details. Command: $(_SmithyCliCommand)"
      Condition="'$(_SmithyCliExitCode)' != '0' and '$(MSBuildRuntimeType)' != 'Core'"
    />

    <!-- The CLI writes over the previous output without removing it, so a file the model no longer
         produces (a renamed shape, or a new NSmithy version laying files out differently) would
         still be compiled next to its replacement. The CLI rewrites every file it produces, so a
         file older than this run is one it no longer produces. Removing them only after the CLI
         has finished means a failed run never leaves the project without its generated code. -->
    <ItemGroup>
      <_SmithyCurrentOutput Include="$(SmithyAllProjectionsGlob);$(SmithyAllProtosGlob);$(_SmithyAllManifestsGlob)" />
      <_SmithyStaleOutput
        Include="@(_SmithyCurrentOutput)"
        Condition="'%(FullPath)' != '' and $([System.IO.File]::GetLastWriteTime('%(FullPath)').Ticks) &lt; $(_SmithyGenerationStart)"
      />
    </ItemGroup>
    <Delete Files="@(_SmithyStaleOutput)" />
    <ItemGroup>
      <_SmithyGeneratedOutput Include="$(SmithyAllProjectionsGlob);$(SmithyAllProtosGlob);$(_SmithyAllManifestsGlob)" />
    </ItemGroup>
    <Error
      Code="NSMITHYGEN"
      Text="NSmithy: the Smithy CLI succeeded but produced no generated files, where the previous run produced @(_SmithyPreviousOutput->Count()). Command: &quot;$(SmithyCliPath)&quot; build --config &quot;$(_SmithyEffectiveBuildFile)&quot; --output &quot;$(_SmithyCliBuildOutput)&quot; $(SmithyExtraArgs)"
      Condition="'$(_SmithyRunsCodeGenerator)' == 'true' and '@(_SmithyPreviousOutput)' != '' and '@(_SmithyGeneratedOutput)' == ''"
    />
    <Touch Files="$(SmithyStampFile)" AlwaysCreate="true" />

    <ItemGroup>
      <FileWrites Include="$(SmithyAllProjectionsGlob);$(_SmithyAllManifestsGlob)" />
      <FileWrites Include="$(SmithyStampFile)" />
    </ItemGroup>
  </Target>

  <Target
    Name="_AddSmithyGeneratedCompileItems"
    DependsOnTargets="GenerateSmithyCode"
    BeforeTargets="CoreCompile"
    Condition="'$(_SmithyIsFSharp)' != 'true'"
  >
    <ItemGroup Condition="'$(_SmithyEffectiveBuildFile)' != ''">
      <Compile Remove="$(SmithyAllProjectionsGlob)" />
      <_SmithyExcludedGeneratedCompile
        Include="$(SmithyBuildOutputPath)*/$(SmithyPlugin)/**/*.Client.g.cs"
        Condition="'$(SmithyGenerateClient)' != 'true'"
      />
      <_SmithyExcludedGeneratedCompile
        Include="$(SmithyBuildOutputPath)*/$(SmithyPlugin)/**/*.Server.g.cs"
        Condition="'$(SmithyGenerateServer)' != 'true'"
      />
      <Compile
        Include="$(SmithyAllProjectionsGlob)"
        Exclude="@(_SmithyExcludedGeneratedCompile)"
        Visible="$(SmithyEmitGeneratedFiles)"
      />
      <_SmithyGeneratedCompile Include="$(SmithyAllProjectionsGlob)" />
      <_SmithyCoreReference
        Include="@(ReferencePath)"
        Condition="'%(ReferencePath.Filename)' == 'NSmithy.Core'"
      />
    </ItemGroup>
    <!-- Generated code needs the runtime. Since every project generates the shapes in its own model
         files, a contracts project that only referenced NSmithy.MSBuild needs it too. -->
    <Error
      Code="NSMITHYRUNTIME"
      Condition="'@(_SmithyGeneratedCompile)' != '' and '@(_SmithyCoreReference)' == ''"
      Text="NSmithy: this project compiles code generated from its Smithy model, which needs the NSmithy.Core package. Add &lt;PackageReference Include=&quot;NSmithy.Core&quot; /&gt;, or set SmithyGenerateCode to false if the project only validates and packages its model."
    />
  </Target>

  <!--
    F# compiles files in order, and a file can only use what the files before it declare. The
    generated files come first: types, the schemas that read and write them, each operation's schema
    and handler interface, then the client and the server. The project's own files come after them and can use all of them. CoreCompile compiles @(Compile) in
    the order FSharpSourceCodeCompileOrder leaves it, so the files are added before that target
    runs.
  -->
  <Target
    Name="_AddSmithyGeneratedFSharpCompileItems"
    DependsOnTargets="GenerateSmithyCode"
    BeforeTargets="FSharpSourceCodeCompileOrder"
    Condition="'$(_SmithyIsFSharp)' == 'true'"
  >
    <ItemGroup Condition="'$(_SmithyEffectiveBuildFile)' != ''">
      <CompileBefore Remove="$(SmithyAllProjectionsGlob)" />
      <CompileBefore
        Include="$(SmithyBuildOutputPath)*/$(SmithyPlugin)/Types.g.fs"
        Visible="$(SmithyEmitGeneratedFiles)"
      />
      <CompileBefore
        Include="$(SmithyBuildOutputPath)*/$(SmithyPlugin)/Schemas.g.fs"
        Visible="$(SmithyEmitGeneratedFiles)"
      />
      <CompileBefore
        Include="$(SmithyBuildOutputPath)*/$(SmithyPlugin)/Operations.g.fs"
        Visible="$(SmithyEmitGeneratedFiles)"
      />
      <CompileBefore
        Include="$(SmithyBuildOutputPath)*/$(SmithyPlugin)/Client.g.fs"
        Visible="$(SmithyEmitGeneratedFiles)"
        Condition="'$(SmithyGenerateClient)' == 'true'"
      />
      <CompileBefore
        Include="$(SmithyBuildOutputPath)*/$(SmithyPlugin)/Server.g.fs"
        Visible="$(SmithyEmitGeneratedFiles)"
        Condition="'$(SmithyGenerateServer)' == 'true'"
      />
    </ItemGroup>
  </Target>

  <!--
    Register the smithy-generated .proto file as a Grpc.Tools <Protobuf> item.
    Must run right before _Protobuf_Compile_BeforeCsCompile so that Grpc.Tools
    picks up the generated .proto and compiles it to C# in the same build pass.

    We cannot use BeforeTargets="BeforeBuild" here because BeforeBuild runs
    before _PrepareSmithyBuildFile writes the effective build file. Using
    _Protobuf_Compile_BeforeCsCompile as the anchor
    ensures our DependsOnTargets chain (_PrepareSmithyBuildFile → GenerateSmithyCode)
    runs first, generating the .proto, before Grpc.Tools looks for proto items.
  -->
  <Target
    Name="_AddSmithyGeneratedProtoItems"
    DependsOnTargets="GenerateSmithyCode"
    BeforeTargets="_Protobuf_Compile_BeforeCsCompile"
    Condition="'$(SmithyGrpc)' == 'true'"
  >
    <ItemGroup>
      <Protobuf
        Include="$(SmithyAllProtosGlob)"
        GrpcServices="$(SmithyGrpcServices)"
        ProtoRoot="$(SmithyBuildOutputPath)"
        Access="Public"
        Visible="$(SmithyEmitGeneratedFiles)"
      />
    </ItemGroup>
    <Message Importance="high" Text="NSmithy: registered Protobuf items: @(Protobuf)" />
  </Target>

  <!--
    Copy the smithy-openapi output of SmithyProjection to wwwroot/openapi.json so that ASP.NET
    Core's static file middleware can serve it at /openapi.json. Runs in Web SDK projects
    whenever the build produced it, whether SmithyOpenApiProtocol or the project's
    smithy-build.json configured it.
  -->
  <Target
    Name="_CopyOpenApiToWwwroot"
    AfterTargets="GenerateSmithyCode"
    Condition="'$(_SmithyEffectiveBuildFile)' != '' and '$(UsingMicrosoftNETSdkWeb)' == 'true'"
  >
    <PropertyGroup>
      <_SmithyOutputDir>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(SmithyBuildOutputPath)'))</_SmithyOutputDir>
    </PropertyGroup>
    <ItemGroup>
      <_OpenApiJson Include="$(_SmithyOutputDir)$(SmithyProjection)/openapi/*.json" />
    </ItemGroup>
    <MakeDir Directories="$(MSBuildProjectDirectory)/wwwroot" Condition="'@(_OpenApiJson)' != ''" />
    <Copy
      SourceFiles="@(_OpenApiJson)"
      DestinationFiles="$(MSBuildProjectDirectory)/wwwroot/openapi.json"
      Condition="'@(_OpenApiJson)' != ''"
      OverwriteReadOnlyFiles="true"
      SkipUnchangedFiles="true"
    />
  </Target>

  <!--
    Copy the smithy-docgen Sphinx HTML output of SmithyProjection to wwwroot/docs/ so that
    ASP.NET Core's static file middleware can serve it at /docs/. Runs in Web SDK projects
    whenever the build produced it, whether SmithyGenerateDocs or the project's
    smithy-build.json configured it.
  -->
  <Target
    Name="_CopyDocgenToWwwroot"
    AfterTargets="GenerateSmithyCode"
    Condition="'$(_SmithyEffectiveBuildFile)' != '' and '$(UsingMicrosoftNETSdkWeb)' == 'true'"
  >
    <PropertyGroup>
      <_SmithyDocgenHtmlDir>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(SmithyBuildOutputPath)', '$(SmithyProjection)', 'docgen', 'build', 'html'))</_SmithyDocgenHtmlDir>
      <_SmithyDocsDestDir>$(MSBuildProjectDirectory)/wwwroot/docs/</_SmithyDocsDestDir>
    </PropertyGroup>
    <ItemGroup>
      <_DocgenHtmlFiles Include="$(_SmithyDocgenHtmlDir)**/*.*" />
    </ItemGroup>
    <MakeDir Directories="$(_SmithyDocsDestDir)" Condition="'@(_DocgenHtmlFiles)' != ''" />
    <Copy
      SourceFiles="@(_DocgenHtmlFiles)"
      DestinationFiles="@(_DocgenHtmlFiles -> '$(_SmithyDocsDestDir)%(RecursiveDir)%(Filename)%(Extension)')"
      Condition="'@(_DocgenHtmlFiles)' != ''"
      OverwriteReadOnlyFiles="true"
      SkipUnchangedFiles="true"
    />
  </Target>
</Project>
