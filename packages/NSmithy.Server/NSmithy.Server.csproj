<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <!--
      NSmithy.MSBuild carries the smithy codegen MSBuild targets. We keep it out of the
      compile/runtime closure (it produces no DLL) but leave "build" un-private so its
      buildTransitive targets flow to consumers of NSmithy.Server.
    -->
    <ProjectReference Include="../NSmithy.MSBuild/NSmithy.MSBuild.csproj"
                      PrivateAssets="compile;runtime;contentfiles;analyzers;native" />

    <!-- Props file sets SmithyGenerateServer=true / SmithyGenerateClient=false by default -->
    <None Include="Targets/NSmithy.Server.props" Pack="true" PackagePath="build/NSmithy.Server.props" />
    <None Include="Targets/NSmithy.Server.props" Pack="true" PackagePath="buildTransitive/NSmithy.Server.props" />
  </ItemGroup>
</Project>
