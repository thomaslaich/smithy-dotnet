{
  "version": "1.0",
  "maven": {
    "repositories": [
      { "url": "https://repo.maven.apache.org/maven2/" }
    ],
    "dependencies": [
      "software.amazon.smithy:smithy-validation-model:1.74.1",
      "io.github.thomaslaich.nsmithy:smithy-csharp-codegen:0.0.0-SNAPSHOT",
      "com.disneystreaming.alloy:alloy-core:0.3.40",
      "com.disneystreaming.alloy:alloy-protocol-tests:0.3.40"
    ]
  },
  "projections": {
    "pizza": {
      "transforms": [
        { "name": "declareValidationException" },
        {
          "name": "includeServices",
          "args": {
            "services": ["alloy.test#PizzaAdminService"]
          }
        }
      ],
      "plugins": {
        "csharp-codegen": {
          "service": "alloy.test#PizzaAdminService",
          "baseNamespace": ""
        }
      }
    },
    "routing": {
      "transforms": [
        { "name": "declareValidationException" },
        {
          "name": "includeServices",
          "args": {
            "services": ["alloy.test.routing#RoutingService"]
          }
        }
      ],
      "plugins": {
        "csharp-codegen": {
          "service": "alloy.test.routing#RoutingService",
          "baseNamespace": ""
        }
      }
    }
  }
}
