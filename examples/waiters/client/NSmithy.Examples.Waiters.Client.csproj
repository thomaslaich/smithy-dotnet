<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SmithyService>example.deployments#Deployments</SmithyService>
    <SmithyGeneratedNamespaces>example.deployments</SmithyGeneratedNamespaces>
    <SmithyGenerateServer>false</SmithyGenerateServer>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <RestorePackagesPath>$(MSBuildProjectDirectory)/obj/packages</RestorePackagesPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NSmithy.Client" Version="0.0.0-SNAPSHOT" />
    <PackageReference Include="NSmithy.Protocols.RestJson" Version="0.0.0-SNAPSHOT" />
    <PackageReference Include="NSmithy.SmithyCli" Version="1.73.0" />
    <ProjectReference Include="../contracts/NSmithy.Examples.Waiters.Contracts.csproj" />
  </ItemGroup>
</Project>
