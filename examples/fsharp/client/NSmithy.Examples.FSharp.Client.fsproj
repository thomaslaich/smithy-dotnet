<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <SmithyService>example.bookshelf#Bookshelf</SmithyService>
    <SmithyGeneratedNamespaces>example.bookshelf</SmithyGeneratedNamespaces>
    <SmithyGenerateServer>false</SmithyGenerateServer>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
    <RestorePackagesPath>$(MSBuildProjectDirectory)/obj/packages</RestorePackagesPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Core" Version="10.1.201" />
    <PackageReference Include="NSmithy.Client" Version="0.0.0-SNAPSHOT" />
    <PackageReference Include="NSmithy.Protocols.RestJson" Version="0.0.0-SNAPSHOT" />
    <PackageReference Include="NSmithy.SmithyCli" Version="1.74.1" />
    <ProjectReference Include="../contracts/NSmithy.Examples.FSharp.Contracts.csproj" />
  </ItemGroup>
</Project>
