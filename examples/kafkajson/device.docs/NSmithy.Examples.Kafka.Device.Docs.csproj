<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace></RootNamespace>
    <!--
      Compose the referenced application contract and infrastructure overlay,
      then emit their platform-neutral AsyncAPI document.
      SmithyGenerateAsyncApi injects bote's asyncapi plugin and copies the document
      to wwwroot/asyncapi.json (the AsyncAPI analogue of SmithyOpenApiProtocol).
    -->
    <SmithyService>examples.kafka.streetlights#StreetlightDevice</SmithyService>
    <SmithyGeneratedNamespaces>examples.kafka.streetlights</SmithyGeneratedNamespaces>
    <SmithyGenerateAsyncApi>true</SmithyGenerateAsyncApi>
    <!--
      smithy-docgen (Sphinx, SmithyGenerateDocs) is disabled: its validation
      decorator hard-rejects bote's @command structures being reused as
      operation inputs without @input, even when the event is suppressed.
    -->
    <SmithyGenerateDocs>false</SmithyGenerateDocs>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <RestorePackagesPath>$(MSBuildProjectDirectory)/obj/packages</RestorePackagesPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Confluent.Kafka" Version="2.6.0" />
    <PackageReference Include="NSmithy.Bote" Version="0.0.0-SNAPSHOT" PrivateAssets="all" />
    <PackageReference Include="NSmithy.Core" Version="0.0.0-SNAPSHOT" />
    <PackageReference Include="NSmithy.Codecs.Json" Version="0.0.0-SNAPSHOT" />
    <PackageReference Include="NSmithy.Server.AspNetCore.Docs" Version="0.0.0-SNAPSHOT" />
    <ProjectReference Include="../device.contracts/NSmithy.Examples.Kafka.Device.Contracts.csproj" />
    <!-- Import its Smithy overlay without importing its generated C# types. -->
    <ProjectReference
      Include="../device.infra/NSmithy.Examples.Kafka.Device.Infra.csproj"
      ReferenceOutputAssembly="false"
    />
  </ItemGroup>
</Project>
