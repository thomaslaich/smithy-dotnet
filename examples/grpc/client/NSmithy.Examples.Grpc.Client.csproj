<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace></RootNamespace>
    <SmithyService>example.library#LibraryService</SmithyService>
    <SmithyGeneratedNamespaces>example.library</SmithyGeneratedNamespaces>
    <SmithyGenerateServer>false</SmithyGenerateServer>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <RestorePackagesPath>$(MSBuildProjectDirectory)/obj/packages</RestorePackagesPath>
  </PropertyGroup>

  <!--
    Native gRPC client: no Grpc.Net.Client / Google.Protobuf / protoc. The generated
    LibraryServiceClient, constructed with `protocol: new GrpcProtocol()`, runs over an
    HTTP/2 HttpClient via NSmithy.Protocols.Grpc.
  -->
  <ItemGroup>
    <ProjectReference Include="../contracts/Library.Contracts.csproj" />
    <PackageReference Include="NSmithy.Client" Version="0.4.0-SNAPSHOT" />
    <PackageReference Include="NSmithy.Core" Version="0.4.0-SNAPSHOT" />
    <PackageReference Include="NSmithy.MSBuild" Version="0.4.0-SNAPSHOT" PrivateAssets="all" />
    <PackageReference Include="NSmithy.Protocols.Grpc" Version="0.4.0-SNAPSHOT" />
  </ItemGroup>
</Project>
