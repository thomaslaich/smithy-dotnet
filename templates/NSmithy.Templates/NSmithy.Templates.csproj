<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageType>Template</PackageType>
    <PackageId>NSmithy.Templates</PackageId>
    <Title>NSmithy Templates</Title>
    <Description>dotnet new templates for scaffolding NSmithy server, contracts, and client projects.</Description>
    <TargetFramework>net10.0</TargetFramework>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ContentTargetFolders>content</ContentTargetFolders>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="content\**\*" Exclude="**\bin\**;**\obj\**" />
  </ItemGroup>
</Project>
