<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SmithyService>example.hello#HelloService</SmithyService>
    <SmithyGeneratedNamespaces>example.hello</SmithyGeneratedNamespaces>
    <SmithyGenerateServer>false</SmithyGenerateServer>
  </PropertyGroup>

  <ItemGroup>
    <!--#if (!IsGrpc)-->
    <PackageReference Include="NSmithy.Client" Version="0.1.0-preview.13" />
    <PackageReference Include="NSmithy.Codecs.Json" Version="0.1.0-preview.13" />
    <PackageReference Include="NSmithy.Protocols.RestJson" Version="0.1.0-preview.13" />
    <!--#endif-->
    <!--#if (IsGrpc)-->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Google.Protobuf" Version="3.30.2" />
    <PackageReference Include="Grpc.Net.Client" Version="2.71.0" />
    <PackageReference Include="Grpc.Tools" Version="2.71.0" PrivateAssets="all" />
    <PackageReference Include="NSmithy.Client" Version="0.1.0-preview.13" />
    <PackageReference Include="NSmithy.Core" Version="0.1.0-preview.13" />
    <PackageReference Include="NSmithy.Http" Version="0.1.0-preview.13" />
    <PackageReference Include="NSmithy.MSBuild" Version="0.1.0-preview.13" PrivateAssets="all" />
    <!--#endif-->
    <!--#if (IsNuget)-->
    <!-- Replace with your actual contracts package name and version -->
    <PackageReference Include="MyService.Contracts" Version="1.0.0" />
    <!--#endif-->
  </ItemGroup>

  <!--#if (IsMaven)-->
  <ItemGroup>
    <!-- Replace with your actual Maven coordinates and version.
         Local dev: dotnet pack the contracts project, then run:
           mvn install:install-file -Dfile=<path>.jar -DpomFile=<path>.pom -Dpackaging=jar
         Remote publishing: dotnet nsmithy push -->
    <SmithyMavenDependency Include="io.github.YOUR_ORG:your-service-contracts:1.0.0" />
  </ItemGroup>
  <!--#endif-->
</Project>
