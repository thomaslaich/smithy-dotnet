<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SmithyService>example.hello#HelloService</SmithyService>
    <SmithyGeneratedNamespaces>example.hello</SmithyGeneratedNamespaces>
    <SmithyGenerateServer>false</SmithyGenerateServer>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NSmithy.Client" Version="NSMITHY_VERSION" />
    <PackageReference Include="NSmithy.Core" Version="NSMITHY_VERSION" />
    <PackageReference Include="NSmithy.Http" Version="NSMITHY_VERSION" />
    <PackageReference Include="NSmithy.MSBuild" Version="NSMITHY_VERSION" PrivateAssets="all" />
    <!-- Runtime packages for the protocol the contracts model declares. -->
    <!--#if (IsGrpc)-->
    <!-- Native gRPC: no Grpc.Net.Client / Google.Protobuf / protoc needed. -->
    <PackageReference Include="NSmithy.Protocols.Grpc" Version="NSMITHY_VERSION" />
    <!--#elif (IsRpcv2Cbor)-->
    <PackageReference Include="NSmithy.Codecs.Cbor" Version="NSMITHY_VERSION" />
    <PackageReference Include="NSmithy.Protocols.RpcV2Cbor" Version="NSMITHY_VERSION" />
    <!--#else-->
    <PackageReference Include="NSmithy.Codecs.Json" Version="NSMITHY_VERSION" />
    <PackageReference Include="NSmithy.Protocols.RestJson" Version="NSMITHY_VERSION" />
    <!--#endif-->
    <!--#if (IsNuget)-->
    <!-- Replace with your actual contracts package name and version -->
    <PackageReference Include="MyService.Contracts" Version="1.0.0" />
    <!--#endif-->
  </ItemGroup>

</Project>
