<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>dotnet-nsmithy</ToolCommandName>
    <RollForward>Major</RollForward>
    <Description>The NSmithy .NET tool. Runs a project's Smithy CLI and publishes the Maven JARs produced by 'dotnet pack'.</Description>
    <PackageTags>$(PackageTags);dotnet-tool;cli;maven</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>
</Project>
